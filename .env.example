# Copy to .env for local overrides. Contains no real secrets: the local stack uses the
# well-known, public Azurite development account key, and all Azure access is keyless
# (Microsoft Entra managed identity), so no API keys or connection secrets are stored here.

# ---- Local Docker Compose stack (APP_MODE=local, Azurite) ----
APP_MODE=local
# Public, well-known Azurite development connection string (documented dev key, not a secret).
AZURITE_TABLE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1
STORAGE_ACCOUNT_NAME=devstoreaccount1
FRONTEND_ORIGIN=http://localhost:8080
API_UPSTREAM=http://api:8000
EXTRA_CONNECT_SRC=http://127.0.0.1:10000 http://localhost:10000

# ---- Foundry / Search endpoints ----
# Content Understanding, embeddings, and GPT-5 have no local emulator. Point these at real
# keyless Azure endpoints to exercise the full pipeline; leave the defaults for a shell-only
# local run. Never put keys or tokens here: runtime auth is Microsoft Entra managed identity.
SEARCH_ENDPOINT=https://localhost
FOUNDRY_ENDPOINT=https://demo.services.ai.azure.com

# ---- Build / deployment (set by azd and Bicep; shown here for reference) ----
RELEASE_SHA=local
