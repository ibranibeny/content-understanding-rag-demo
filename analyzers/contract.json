{
  "analyzerId": "workshop_contract",
  "name": "Contract",
  "description": "Extracts parties, dates, terms, obligations, termination, and risks from a contract.",
  "baseAnalyzerId": "prebuilt-document",
  "models": {
    "completion": "gpt-5",
    "embedding": "text-embedding-3-large"
  },
  "dynamicFieldSchema": false,
  "config": {
    "returnDetails": true,
    "tableFormat": "markdown",
    "estimateFieldSourceAndConfidence": true
  },
  "fieldSchema": {
    "name": "ContractFields",
    "fields": {
      "title": {"type": "string", "description": "Contract title."},
      "parties": {"type": "array", "description": "Contracting parties.", "items": {"type": "string"}},
      "effectiveDate": {"type": "date", "description": "Effective date."},
      "expirationDate": {"type": "date", "description": "Expiration date."},
      "renewalTerms": {"type": "string", "description": "Renewal provisions."},
      "governingLaw": {"type": "string", "description": "Governing law or jurisdiction."},
      "obligations": {"type": "array", "description": "Material obligations.", "items": {"type": "string"}},
      "terminationClauses": {"type": "array", "description": "Termination provisions.", "items": {"type": "string"}},
      "riskFlags": {"type": "array", "description": "Potential contract risks.", "items": {"type": "string"}}
    }
  }
}
